// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User model
model User {
  id           Int        @id @default(autoincrement())
  username     String     @unique
  email        String     @unique
  passwordHash String     @map("password_hash")
  favorites    Favorite[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

// Recipe model
model Recipe {
  id              Int         @id @default(autoincrement())
  title           String      @db.VarChar(255)
  description     String?     @db.Text
  ingredients     String[]
  ingredientNames String[]    @map("ingredient_names")
  instructions    String[]
  servingSize     Float?      @map("serving_size")
  servingSizeUnit String?     @map("serving_size_unit") @db.VarChar(50)
  servings        Int?
  imageUrl        String?     @map("image_url") @db.VarChar(500)
  sourceUrl       String?     @map("source_url") @db.VarChar(500)
  tags            RecipeTag[]
  favorites       Favorite[]
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("recipes")
}

// Tag model
model Tag {
  id        Int         @id @default(autoincrement())
  name      String      @unique @db.VarChar(100)
  category  String      @db.VarChar(100)
  recipes   RecipeTag[]
  createdAt DateTime    @default(now()) @map("created_at")

  @@map("tags")
}

// RecipeTag junction table (many-to-many: Recipe ↔ Tag)
model RecipeTag {
  recipeId Int    @map("recipe_id")
  tagId    Int    @map("tag_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@map("recipe_tags")
}

// Favorite junction table (many-to-many: User ↔ Recipe)
model Favorite {
  userId    Int      @map("user_id")
  recipeId  Int      @map("recipe_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, recipeId])
  @@map("favorites")
}